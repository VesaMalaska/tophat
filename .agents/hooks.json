{
  "context-io-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^(replace_file_content|multi_replace_file_content|write_to_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/antigravity-hook.ts pre-write",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(replace_file_content|multi_replace_file_content|write_to_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/antigravity-hook.ts post-write",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "macro-reset-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/antigravity-hook.ts pre-command",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/antigravity-hook.ts post-command",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
