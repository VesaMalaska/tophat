{
    "context-io-gate": {
        "enabled": true,
        "PreToolUse": [
            {
                "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "mkdir -p .git/locks && lockfile-create --use-pid --retry 3 .git/locks/antigravity.lock > /dev/null 2>&1 && echo '{\"decision\": \"allow\", \"reason\": \"File system lock verified\"}' || echo '{\"decision\": \"deny\", \"reason\": \"File system locked by another agent\"}'",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "lockfile-remove .git/locks/antigravity.lock > /dev/null 2>&1; echo '{}'",
                        "timeout": 5
                    }
                ]
            }
        ]
    },
    "static-analysis-gate": {
        "enabled": true,
        "PostToolUse": [
            {
                "matcher": "run_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"if(process.env.ANTIGRAVITY_CMD.includes('git commit')) process.exit(0); else process.exit(1);\" || npx tsx .agents/scripts/run-static-analysis.ts",
                    "timeout": 45
                    }
                ]
            }
        ]
    },
    "protect-strategy-memory": {
        "enabled": true,
        "PreToolUse": [
            {
                "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx tsx .agents/scripts/enforce-strategy-lock.ts",
                        "timeout": 5
                    }
                ]
            }
        ]
    },
    "enforce-svelte-runes": {
        "enabled": true,
        "PreToolUse": [
            {
                "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx tsx .agents/scripts/enforce-svelte-runes.ts",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}